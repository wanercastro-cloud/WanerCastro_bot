# Telegram (obrigatório para receber ranking)
TELEGRAM_TOKEN=seu_token_do_bot
TELEGRAM_CHAT_ID=seu_chat_id

# CoinGecko (opcional, para plano Pro)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Comportamento
USE_DYNAMIC_FILTER=true
STATIC_COINS=bitcoin,ethereum,solana
SLEEP_INTERVAL=7200
TOP_BUY_COUNT=5

# Filtros de mercado
VS_CURRENCY=usd
PER_PAGE=250
PAGES=1
CANDIDATES=35
MIN_MCAP=2000000
MAX_MCAP=300000000
MIN_VOL24=1500000
EXCLUDE_STABLES=true