# CoinGecko
COINGECKO_API_KEY=XXX
COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
VS_CURRENCY=usd

# Telegram
TG_BOT_TOKEN=XXX
TG_CHAT_ID=XXX

# Scanner
TOP_N=10
CANDIDATES=150

MIN_MCAP=2000000
MAX_MCAP=250000000
MIN_VOL24=1500000
EXCLUDE_STABLES=true

# Subida
MIN_CHG_1H_UP=1.2
MIN_ACCEL_UP=0.8
MIN_VM_UP=0.35
MAX_CHG_24H_OVERHEAT=35

# Descida
MAX_CHG_1H_DOWN=-1.8
MIN_VM_DOWN=0.40
MIN_DUMP_24H=-6

# Score
WEIGHT_VM=45
WEIGHT_ACCEL=20
WEIGHT_CHG_1H=20
WEIGHT_CHG_24H=15
PENALTY_OVERHEAT=18

# Alertas
MIN_SCORE_UP_ALERT=65
MIN_SCORE_DOWN_ALERT=60
ALERT_COOLDOWN_MIN=15

# Runtime
HTTP_TIMEOUT=20
HTTP_RETRIES=3
SCAN_INTERVAL_MIN=5
SEND_STARTUP_MESSAGE=true