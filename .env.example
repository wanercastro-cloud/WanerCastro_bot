# Telegram (obrigatório)
TELEGRAM_TOKEN=seu_token
TELEGRAM_CHAT_ID=seu_chat_id

# CoinGecko (opcional)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Comportamento
USE_DYNAMIC_FILTER=true
STATIC_COINS=
SLEEP_INTERVAL=3600
TOP_BUY_COUNT=5
MIN_SCORE_FOR_RANKING=0.6

# Filtros de mercado (ajuste conforme preferência)
VS_CURRENCY=usd
PER_PAGE=250
PAGES=1
CANDIDATES=35
MIN_MCAP=10000000
MAX_MCAP=500000000
MIN_VOL24=5000000
EXCLUDE_STABLES=true